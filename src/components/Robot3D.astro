
---
/**
 * Robot3D.astro
 * SIS Robot 3.0 — Premium Industrial AI Assistant
 * Framework: Astro
 * Renderer: Three.js
 * Install: npm install three
 *
 * Features:
 * - Interactive 3D industrial robot
 * - Manual drag rotation only
 * - Animated optical eyes
 * - Integrated 3D talking mouth
 * - Speech event integration
 * - Optional interface visibility
 * - Responsive rendering
 * - Reduced-motion support
 * - WebGL fallback
 */

interface Props {
  showInterface?: boolean;
  compact?: boolean;
}

const {
  showInterface = true,
  compact = false
} = Astro.props;
---

<div
  class:list={["sis-robot", compact && "sis-robot--compact"]}
  data-sis-robot
  aria-label="Interactive SIS AI assistant"
>
  <canvas
    class="sis-robot__canvas"
    aria-label="Interactive 3D robot. Drag to rotate. Click to interact."
    tabindex="0"
  ></canvas>

  <img
    src="/robot.png"
    alt="SIS robot assistant"
    class="sis-robot__fallback"
    hidden
  />

  {showInterface && (
    <button
      class="sis-robot__speech"
      type="button"
      aria-live="polite"
      aria-label="Change robot behavior"
    >
      <span class="sis-robot__status" aria-hidden="true"></span>

      <span class="sis-robot__speech-text">
        Systems online. Ready to assist.
      </span>

      <span class="sis-robot__speech-icon" aria-hidden="true">
        ↗
      </span>
    </button>
  )}

  {showInterface && (
    <span class="sis-robot__caption" aria-hidden="true">
      SIS / INTELLIGENCE UNIT 01
    </span>
  )}
</div>

<style>
  .sis-robot {
    --robot-accent: #b83232;

    position: relative;
    isolation: isolate;

    width: min(100%, 440px);
    height: clamp(390px, 44vw, 520px);

    margin-inline: auto;

    user-select: none;
    -webkit-user-select: none;
  }

  .sis-robot::before {
    content: "";

    position: absolute;
    z-index: -1;

    width: 85%;
    aspect-ratio: 1;

    left: 7.5%;
    top: 16%;

    border-radius: 50%;

    background: radial-gradient(
      circle,
      rgba(184, 50, 50, 0.15),
      rgba(184, 50, 50, 0.045) 45%,
      transparent 72%
    );

    filter: blur(20px);

    pointer-events: none;
  }

  .sis-robot::after {
    content: "";

    position: absolute;
    z-index: -1;

    left: 20%;
    right: 20%;
    bottom: 8%;

    height: 1px;

    background: linear-gradient(
      90deg,
      transparent,
      rgba(184, 50, 50, 0.35),
      transparent
    );

    pointer-events: none;
  }

  .sis-robot__canvas {
    display: block;

    width: 100%;
    height: 100%;

    outline: none;

    touch-action: pan-y;
    cursor: grab;
  }

  .sis-robot__canvas:active {
    cursor: grabbing;
  }

  .sis-robot__canvas:focus-visible {
    outline: 2px solid var(--robot-accent);
    outline-offset: -5px;
    border-radius: 18px;
  }

  .sis-robot__speech {
    position: absolute;
    z-index: 3;

    top: 3%;
    left: 50%;

    transform: translateX(-50%);

    display: inline-flex;
    align-items: center;
    gap: 10px;

    max-width: 94%;
    min-height: 42px;

    padding: 10px 14px;

    border: 1px solid rgba(120, 126, 138, 0.28);
    border-radius: 9px;

    background: rgba(18, 20, 25, 0.9);
    color: #f5f5f6;

    box-shadow:
      0 12px 34px rgba(0, 0, 0, 0.17),
      inset 0 1px rgba(255, 255, 255, 0.07);

    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    font: 500 11px/1.4 "IBM Plex Sans", system-ui, sans-serif;
    letter-spacing: 0.025em;

    white-space: nowrap;
    cursor: pointer;

    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      box-shadow 0.25s ease;
  }

  .sis-robot__speech:hover {
    border-color: rgba(184, 50, 50, 0.75);

    background: rgba(27, 23, 26, 0.97);

    box-shadow: 0 14px 38px rgba(120, 20, 20, 0.2);
  }

  .sis-robot__status {
    width: 7px;
    height: 7px;

    flex: 0 0 7px;

    border-radius: 50%;

    background: #d35a5a;

    box-shadow: 0 0 12px rgba(211, 90, 90, 0.8);
  }

  .sis-robot__speech-icon {
    color: #df7777;
    font-size: 14px;
    margin-left: 3px;
  }

  .sis-robot__caption {
    position: absolute;

    bottom: 3%;
    left: 50%;

    transform: translateX(-50%);

    color: currentColor;
    opacity: 0.48;

    font: 500 9px/1 "IBM Plex Mono", monospace;
    letter-spacing: 0.2em;

    white-space: nowrap;
    pointer-events: none;
  }

  .sis-robot__fallback {
    width: 100%;
    height: 100%;

    object-fit: contain;
  }

  .sis-robot__fallback:not([hidden]) {
    display: block;
  }

  @media (max-width: 640px) {
    .sis-robot {
      width: min(100%, 350px);
      height: 410px;
    }

    .sis-robot__speech {
      top: 2%;
      font-size: 10px;
      padding: 9px 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sis-robot__speech {
      transition: none;
    }
  }

  /* Compact robot — ROI calculator only */
  .sis-robot--compact {
    width: 90px;
    height: 110px;
    min-width: 90px;
    margin: 0;
    overflow: hidden;
  }

  .sis-robot--compact::before,
  .sis-robot--compact::after {
    display: none;
  }

</style>

<script>
  import * as THREE from "three";

  const mountRobot = (wrapper: HTMLElement) => {
    if (wrapper.dataset.initialized === "true") return;

    const canvas = wrapper.querySelector<HTMLCanvasElement>(
      ".sis-robot__canvas"
    );

    const speech = wrapper.querySelector<HTMLButtonElement>(
      ".sis-robot__speech"
    );

    const speechText = wrapper.querySelector<HTMLElement>(
      ".sis-robot__speech-text"
    );

    const fallback = wrapper.querySelector<HTMLImageElement>(
      ".sis-robot__fallback"
    );

    if (!canvas) return;

    // --------------------------------------------------
    // WEBGL INITIALIZATION
    // --------------------------------------------------

    let renderer: THREE.WebGLRenderer;

    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: "high-performance",
      });
    } catch (error) {
      console.warn("SIS Robot: WebGL unavailable.", error);

      canvas.hidden = true;

      if (fallback) {
        fallback.hidden = false;
      }

      return;
    }

    wrapper.dataset.initialized = "true";

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let disposed = false;

    // --------------------------------------------------
    // SCENE AND CAMERA
    // --------------------------------------------------

    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      32,
      1,
      0.1,
      60
    );

    if (wrapper.classList.contains("sis-robot--compact")) {
      camera.position.set(0, -0.15, 10);
      } else {
        camera.position.set(0, 0.12, 7.5);
      }

    renderer.setPixelRatio(
      Math.min(window.devicePixelRatio || 1, 1.5)
    );

    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.15;

    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    // --------------------------------------------------
    // MATERIALS
    // --------------------------------------------------

    const shellMat = new THREE.MeshPhysicalMaterial({
      color: 0xe9ebef,
      roughness: 0.25,
      metalness: 0.24,
      clearcoat: 1,
      clearcoatRoughness: 0.18,
    });

    const armorMat = new THREE.MeshPhysicalMaterial({
      color: 0xbcc2cb,
      roughness: 0.3,
      metalness: 0.55,
      clearcoat: 0.65,
    });

    const darkMat = new THREE.MeshPhysicalMaterial({
      color: 0x191d25,
      roughness: 0.22,
      metalness: 0.65,
      clearcoat: 0.9,
    });

    const jointMat = new THREE.MeshStandardMaterial({
      color: 0x353b46,
      roughness: 0.42,
      metalness: 0.7,
    });

    const accentMat = new THREE.MeshStandardMaterial({
      color: 0xa72e34,
      roughness: 0.26,
      metalness: 0.4,
      emissive: 0x570b10,
      emissiveIntensity: 0.55,
    });

    const glowMat = new THREE.MeshBasicMaterial({
      color: 0xef6969,
      transparent: true,
      opacity: 0.8,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      toneMapped: false,
    });

    // --------------------------------------------------
    // LIGHTING
    // --------------------------------------------------

    scene.add(
      new THREE.HemisphereLight(
        0xeaf0fa,
        0x34323a,
        1.8
      )
    );

    const keyLight = new THREE.DirectionalLight(
      0xffffff,
      3
    );

    keyLight.position.set(4, 6, 7);
    keyLight.castShadow = true;

    keyLight.shadow.mapSize.set(1024, 1024);

    keyLight.shadow.camera.left = -4;
    keyLight.shadow.camera.right = 4;
    keyLight.shadow.camera.top = 5;
    keyLight.shadow.camera.bottom = -4;

    scene.add(keyLight);

    const fillLight = new THREE.DirectionalLight(
      0xc4d1e3,
      1.5
    );

    fillLight.position.set(-5, 1, 5);
    scene.add(fillLight);

    const rimLight = new THREE.PointLight(
      0xc64b50,
      22,
      12,
      2
    );

    rimLight.position.set(0, 2, -3);
    scene.add(rimLight);

    const faceLight = new THREE.PointLight(
      0x7f3439,
      5,
      5,
      2
    );

    faceLight.position.set(0, 0.8, 3);
    scene.add(faceLight);

    // --------------------------------------------------
    // ROBOT ROOT
    // --------------------------------------------------

    const robot = new THREE.Group();

    scene.add(robot);

    robot.position.y = -0.05;

    const headPivot = new THREE.Group();

    headPivot.position.y = 0.9;

    robot.add(headPivot);

    const torso = new THREE.Group();

    torso.position.y = -0.55;

    robot.add(torso);

    // --------------------------------------------------
    // HEAD / ARMORED HELMET
    // --------------------------------------------------

    const helmet = new THREE.Mesh(
      new THREE.SphereGeometry(1, 56, 48),
      shellMat
    );

    helmet.scale.set(1.08, 0.91, 0.83);

    helmet.castShadow = true;
    helmet.receiveShadow = true;

    headPivot.add(helmet);

    // Side armor panels.

    [-1, 1].forEach((side) => {
      const panel = new THREE.Mesh(
        new THREE.BoxGeometry(0.2, 0.48, 0.13),
        armorMat
      );

      panel.position.set(
        side * 0.91,
        -0.13,
        0.43
      );

      panel.rotation.z = side * -0.12;

      headPivot.add(panel);

      const panelLine = new THREE.Mesh(
        new THREE.BoxGeometry(0.025, 0.27, 0.018),
        darkMat
      );

      panelLine.position.set(
        side * 0.96,
        -0.13,
        0.505
      );

      headPivot.add(panelLine);
    });

    // Dark glass faceplate.

    const visor = new THREE.Mesh(
      new THREE.SphereGeometry(1, 56, 40),
      darkMat
    );

    visor.scale.set(1.045, 0.72, 0.17);

    visor.position.set(0, -0.025, 0.72);

    headPivot.add(visor);

    // Lower protective frame.

    const chin = new THREE.Mesh(
      new THREE.BoxGeometry(1.1, 0.14, 0.12),
      armorMat
    );

    chin.position.set(0, -0.55, 0.69);

    headPivot.add(chin);

    // Brow rail.

    const brow = new THREE.Mesh(
      new THREE.BoxGeometry(1.55, 0.065, 0.12),
      darkMat
    );

    brow.position.set(0, 0.43, 0.72);

    headPivot.add(brow);

    // Optical sensor.

    const sensor = new THREE.Mesh(
      new THREE.SphereGeometry(0.065, 24, 20),
      accentMat
    );

    sensor.position.set(0, 0.55, 0.72);

    headPivot.add(sensor);

    const sensorGlow = new THREE.Mesh(
      new THREE.SphereGeometry(0.09, 20, 16),
      glowMat
    );

    sensorGlow.position.copy(sensor.position);

    headPivot.add(sensorGlow);

    // --------------------------------------------------
    // EYE DISPLAY
    // --------------------------------------------------

    const eyeCanvas = document.createElement("canvas");

    eyeCanvas.width = 768;
    eyeCanvas.height = 320;

    const eyeCtx = eyeCanvas.getContext("2d");

    if (!eyeCtx) {
      renderer.dispose();

      wrapper.dataset.initialized = "false";

      canvas.hidden = true;

      if (fallback) {
        fallback.hidden = false;
      }

      return;
    }

    let blink = 0;
    let blinkClock = 0;
    let blinkHold = 0;

    let lookX = 0;
    let lookY = 0;

    let eyeExpression = "normal";
    let eyesDirty = true;

    const drawEyes = () => {
      eyeCtx.clearRect(0, 0, 768, 320);

      const eyeY = 135 + lookY * 10;

      const eyeHeight = Math.max(
        3,
        42 * (1 - blink)
      );

      const eyeWidth =
        eyeExpression === "thinking" ? 28 : 35;

      const drawEye = (x: number) => {
        eyeCtx.save();

        eyeCtx.shadowColor = "#e16b6b";
        eyeCtx.shadowBlur = 20;

        const gradient = eyeCtx.createLinearGradient(
          x,
          eyeY - 42,
          x,
          eyeY + 42
        );

        gradient.addColorStop(0, "#ffc1c1");
        gradient.addColorStop(0.45, "#df6868");
        gradient.addColorStop(1, "#a72d34");

        eyeCtx.fillStyle = gradient;

        eyeCtx.beginPath();

        eyeCtx.ellipse(
          x + lookX * 12,
          eyeY,
          eyeWidth,
          eyeHeight,
          0,
          0,
          Math.PI * 2
        );

        eyeCtx.fill();

        eyeCtx.restore();
      };

      if (blink > 0.9) {
        eyeCtx.strokeStyle = "#df7777";
        eyeCtx.lineWidth = 8;
        eyeCtx.lineCap = "round";

        [260, 508].forEach((x) => {
          eyeCtx.beginPath();

          eyeCtx.moveTo(x - 28, eyeY);
          eyeCtx.lineTo(x + 28, eyeY);

          eyeCtx.stroke();
        });
      } else {
        drawEye(260);
        drawEye(508);
      }

      // Optical status arc.

      eyeCtx.strokeStyle = "rgba(224,112,112,.9)";
      eyeCtx.lineWidth = 4;

      eyeCtx.beginPath();

      eyeCtx.arc(
        384 + lookX * 8,
        238,
        17,
        0.18 * Math.PI,
        0.82 * Math.PI
      );

      eyeCtx.stroke();

      eyesDirty = false;
    };

    drawEyes();

    const eyeTexture = new THREE.CanvasTexture(eyeCanvas);

    eyeTexture.colorSpace = THREE.SRGBColorSpace;

    const eyeMaterial = new THREE.MeshBasicMaterial({
      map: eyeTexture,
      transparent: true,
      depthWrite: false,
      toneMapped: false,
    });

    const eyeScreen = new THREE.Mesh(
      new THREE.PlaneGeometry(1.48, 0.62),
      eyeMaterial
    );

    eyeScreen.position.set(0, -0.02, 0.91);

    headPivot.add(eyeScreen);

    // --------------------------------------------------
    // 3D ANIMATED MOUTH
    // --------------------------------------------------

    const mouthGroup = new THREE.Group();

    mouthGroup.position.set(0, -0.36, 0.89);

    mouthGroup.scale.set(1, 0.12, 1);

    headPivot.add(mouthGroup);

    // Mouth interior.

    const mouthMaterial = new THREE.MeshBasicMaterial({
      color: 0x090b10,
      toneMapped: false,
    });

    const mouthShape = new THREE.Mesh(
      new THREE.CapsuleGeometry(
        0.045,
        0.15,
        5,
        16
      ),
      mouthMaterial
    );

    mouthShape.rotation.z = Math.PI / 2;

    mouthGroup.add(mouthShape);

    // Inner red glow.

    const mouthGlowMaterial = new THREE.MeshBasicMaterial({
      color: 0xa72e34,
      transparent: true,
      opacity: 0.08,
      toneMapped: false,
    });

    const mouthGlow = new THREE.Mesh(
      new THREE.CapsuleGeometry(
        0.018,
        0.09,
        4,
        12
      ),
      mouthGlowMaterial
    );

    mouthGlow.rotation.z = Math.PI / 2;

    mouthGlow.position.z = 0.012;

    mouthGroup.add(mouthGlow);

    // Speech animation state.

    let mouthTarget = 0.12;
    let mouthCurrent = 0.12;

    let speechActive = false;

    const mouthShapes = [
      0.55,
      1.15,
      0.78,
      0.38,
    ];

    const onRobotSpeaking = (event: Event) => {
      const customEvent = event as CustomEvent<{
        speaking?: boolean;
        phoneme?: number;
      }>;

      const detail = customEvent.detail ?? {};

      speechActive = Boolean(detail.speaking);

      if (!speechActive) {
        mouthTarget = 0.12;
        return;
      }

      const phoneme = Math.abs(
        Math.floor(detail.phoneme ?? 0)
      ) % mouthShapes.length;

      mouthTarget = mouthShapes[phoneme];
    };

    wrapper.addEventListener(
      "sis-robot-speaking",
      onRobotSpeaking
    );

    // --------------------------------------------------
    // SIDE OPTICAL MODULES
    // --------------------------------------------------

    [-1, 1].forEach((side) => {
      const pod = new THREE.Group();

      pod.position.set(
        side * 1.03,
        -0.04,
        0.02
      );

      headPivot.add(pod);

      const outer = new THREE.Mesh(
        new THREE.CylinderGeometry(
          0.23,
          0.23,
          0.2,
          32
        ),
        armorMat
      );

      outer.rotation.z = Math.PI / 2;

      pod.add(outer);

      const inner = new THREE.Mesh(
        new THREE.CylinderGeometry(
          0.14,
          0.14,
          0.22,
          32
        ),
        darkMat
      );

      inner.rotation.z = Math.PI / 2;

      pod.add(inner);

      const core = new THREE.Mesh(
        new THREE.SphereGeometry(
          0.075,
          20,
          16
        ),
        glowMat
      );

      core.position.x = side * 0.13;

      pod.add(core);
    });

    // --------------------------------------------------
    // NECK
    // --------------------------------------------------

    const neck = new THREE.Mesh(
      new THREE.CylinderGeometry(
        0.2,
        0.27,
        0.3,
        32
      ),
      jointMat
    );

    neck.position.y = 0.57;

    torso.add(neck);

    const neckRing = new THREE.Mesh(
      new THREE.TorusGeometry(
        0.24,
        0.035,
        12,
        40
      ),
      accentMat
    );

    neckRing.position.y = 0.53;
    neckRing.rotation.x = Math.PI / 2;

    torso.add(neckRing);

    // --------------------------------------------------
    // TORSO / CHEST
    // --------------------------------------------------

    const chest = new THREE.Mesh(
      new THREE.SphereGeometry(
        0.72,
        48,
        40
      ),
      shellMat
    );

    chest.scale.set(0.9, 0.86, 0.58);

    chest.position.y = 0.05;

    chest.castShadow = true;
    chest.receiveShadow = true;

    torso.add(chest);

    // Main chest plate.

    const chestPlate = new THREE.Mesh(
      new THREE.BoxGeometry(
        0.78,
        0.65,
        0.17
      ),
      darkMat
    );

    chestPlate.position.set(
      0,
      0.06,
      0.49
    );

    chestPlate.rotation.z = -0.035;

    torso.add(chestPlate);

    // Upper armor plates.

    [-1, 1].forEach((side) => {
      const plate = new THREE.Mesh(
        new THREE.BoxGeometry(
          0.3,
          0.24,
          0.07
        ),
        armorMat
      );

      plate.position.set(
        side * 0.48,
        0.33,
        0.4
      );

      plate.rotation.z = side * -0.2;

      torso.add(plate);
    });

    // Red identification line.

    const chestLine = new THREE.Mesh(
      new THREE.BoxGeometry(
        0.53,
        0.035,
        0.025
      ),
      accentMat
    );

    chestLine.position.set(
      0,
      0.27,
      0.59
    );

    torso.add(chestLine);

    // Central insignia.

    const emblem = new THREE.Mesh(
      new THREE.OctahedronGeometry(
        0.11,
        1
      ),
      accentMat
    );

    emblem.position.set(
      0,
      -0.09,
      0.59
    );

    emblem.scale.set(1, 1, 0.35);

    torso.add(emblem);

    // Mechanical ventilation details.

    for (let i = 0; i < 3; i++) {
      const vent = new THREE.Mesh(
        new THREE.BoxGeometry(
          0.27,
          0.018,
          0.025
        ),
        armorMat
      );

      vent.position.set(
        0,
        -0.31 - i * 0.055,
        0.56
      );

      torso.add(vent);
    }

    // --------------------------------------------------
    // ARTICULATED ARMS
    // --------------------------------------------------

    const arms: THREE.Group[] = [];

    [-1, 1].forEach((side) => {
      const shoulderPivot = new THREE.Group();

      shoulderPivot.position.set(
        side * 0.64,
        0.32,
        0
      );

      torso.add(shoulderPivot);

      arms.push(shoulderPivot);

      const shoulder = new THREE.Mesh(
        new THREE.SphereGeometry(
          0.21,
          32,
          24
        ),
        armorMat
      );

      shoulderPivot.add(shoulder);

      const shoulderCap = new THREE.Mesh(
        new THREE.SphereGeometry(
          0.17,
          28,
          20
        ),
        darkMat
      );

      shoulderCap.scale.set(0.8, 1, 0.8);

      shoulderCap.position.z = 0.11;

      shoulderPivot.add(shoulderCap);

      const upper = new THREE.Mesh(
        new THREE.CapsuleGeometry(
          0.12,
          0.3,
          5,
          16
        ),
        shellMat
      );

      upper.position.set(
        side * 0.14,
        -0.26,
        0.02
      );

      upper.rotation.z = side * -0.4;

      shoulderPivot.add(upper);

      const elbow = new THREE.Mesh(
        new THREE.SphereGeometry(
          0.14,
          24,
          20
        ),
        jointMat
      );

      elbow.position.set(
        side * 0.26,
        -0.49,
        0.05
      );

      shoulderPivot.add(elbow);

      const elbowCore = new THREE.Mesh(
        new THREE.SphereGeometry(
          0.065,
          20,
          16
        ),
        accentMat
      );

      elbowCore.position.copy(elbow.position);

      elbowCore.position.z += 0.105;

      shoulderPivot.add(elbowCore);

      const forearm = new THREE.Mesh(
        new THREE.CapsuleGeometry(
          0.145,
          0.31,
          5,
          16
        ),
        armorMat
      );

      forearm.position.set(
        side * 0.33,
        -0.71,
        0.07
      );

      forearm.rotation.z = side * -0.27;

      forearm.castShadow = true;

      shoulderPivot.add(forearm);

      const cuff = new THREE.Mesh(
        new THREE.TorusGeometry(
          0.14,
          0.025,
          12,
          32
        ),
        darkMat
      );

      cuff.position.set(
        side * 0.35,
        -0.88,
        0.08
      );

      cuff.rotation.z = Math.PI / 2;

      shoulderPivot.add(cuff);

      const hand = new THREE.Mesh(
        new THREE.SphereGeometry(
          0.14,
          24,
          20
        ),
        jointMat
      );

      hand.scale.set(0.9, 0.8, 0.8);

      hand.position.set(
        side * 0.35,
        -1.01,
        0.08
      );

      shoulderPivot.add(hand);

      // Finger details.

      [-1, 0, 1].forEach((finger) => {
        const detail = new THREE.Mesh(
          new THREE.BoxGeometry(
            0.035,
            0.095,
            0.045
          ),
          darkMat
        );

        detail.position.set(
          side * 0.35 + finger * 0.065,
          -1.12,
          0.14
        );

        shoulderPivot.add(detail);
      });
    });

    // --------------------------------------------------
    // HOVER PROPULSION SYSTEM
    // --------------------------------------------------

    const engine = new THREE.Group();

    engine.position.y = -1.55;

    robot.add(engine);

    const engineBody = new THREE.Mesh(
      new THREE.CylinderGeometry(
        0.31,
        0.43,
        0.32,
        48
      ),
      darkMat
    );

    engine.add(engineBody);

    const engineTop = new THREE.Mesh(
      new THREE.CylinderGeometry(
        0.34,
        0.29,
        0.1,
        48
      ),
      armorMat
    );

    engineTop.position.y = 0.19;

    engine.add(engineTop);

    const engineCore = new THREE.Mesh(
      new THREE.CylinderGeometry(
        0.12,
        0.23,
        0.24,
        40
      ),
      new THREE.MeshBasicMaterial({
        color: 0xed6868,
        transparent: true,
        opacity: 0.8,
        toneMapped: false,
      })
    );

    engineCore.position.y = -0.2;

    engine.add(engineCore);

    // Energy rings.

    const rings: THREE.Mesh[] = [];

    [0.48, 0.36, 0.24].forEach(
      (radius, index) => {
        const ring = new THREE.Mesh(
          new THREE.TorusGeometry(
            radius,
            index === 0 ? 0.018 : 0.012,
            12,
            64
          ),
          glowMat.clone()
        );

        ring.rotation.x = Math.PI / 2;

        ring.position.y = -0.35 - index * 0.12;

        engine.add(ring);

        rings.push(ring);
      }
    );

    // Energy beam.

    const beamMaterial = new THREE.MeshBasicMaterial({
      color: 0xd95b62,
      transparent: true,
      opacity: 0.12,
      side: THREE.DoubleSide,
      depthWrite: false,
      toneMapped: false,
    });

    const beam = new THREE.Mesh(
      new THREE.CylinderGeometry(
        0.1,
        0.3,
        0.48,
        32,
        1,
        true
      ),
      beamMaterial
    );

    beam.position.y = -0.52;

    engine.add(beam);

    // --------------------------------------------------
    // GROUND SHADOW
    // --------------------------------------------------

    const shadow = new THREE.Mesh(
      new THREE.CircleGeometry(
        0.95,
        48
      ),
      new THREE.MeshBasicMaterial({
        color: 0x777b84,
        transparent: true,
        opacity: 0.12,
        depthWrite: false,
      })
    );

    shadow.rotation.x = -Math.PI / 2;

    shadow.position.set(
      0,
      -2.18,
      0
    );

    robot.add(shadow);

    // --------------------------------------------------
    // ROBOT BEHAVIOR SYSTEM
    // --------------------------------------------------

    type RobotState =
      | "idle"
      | "observing"
      | "thinking"
      | "interacting"
      | "presenting";

    const states: {
      name: RobotState;
      message: string;
      expression: string;
    }[] = [
      {
        name: "idle",
        message: "Systems online. Ready to assist.",
        expression: "normal",
      },
      {
        name: "observing",
        message: "Monitoring. Everything is connected.",
        expression: "normal",
      },
      {
        name: "thinking",
        message: "Analyzing possibilities. Optimizing systems.",
        expression: "thinking",
      },
      {
        name: "interacting",
        message: "How can intelligent automation help you?",
        expression: "normal",
      },
      {
        name: "presenting",
        message: "Intelligence, engineered into the business.",
        expression: "normal",
      },
    ];

    let currentState = 0;

    let state: RobotState = "idle";

    let targetArmPose = 0;
    let currentArmPose = 0;

    // Pointer / rotation variables.

    let pointerDown = false;
    let dragged = false;

    let previousX = 0;

    let rotationY = 0;
    let velocityY = 0;

    let pointerX = 0;
    let pointerY = 0;

    let targetX = 0;
    let targetY = 0;

    const changeState = () => {
      currentState =
        (currentState + 1) % states.length;

      const selected = states[currentState];

      state = selected.name;

      if (speechText) {
        speechText.textContent = selected.message;
      }

      eyeExpression = selected.expression;

      eyesDirty = true;

      velocityY += 0.025;

      targetArmPose =
        state === "presenting" ? 0.45 : 0;
    };

    const onSpeechClick = () => {
      changeState();
    };

    speech?.addEventListener(
      "click",
      onSpeechClick
    );

    // --------------------------------------------------
    // POINTER INTERACTION
    // --------------------------------------------------

    const onPointerDown = (event: PointerEvent) => {
      pointerDown = true;

      dragged = false;

      previousX = event.clientX;

      canvas.setPointerCapture(event.pointerId);
    };

    const onPointerMove = (event: PointerEvent) => {
      const rect = wrapper.getBoundingClientRect();

      if (rect.width === 0 || rect.height === 0) {
        return;
      }

      targetX = THREE.MathUtils.clamp(
        ((event.clientX - rect.left) /
          rect.width -
          0.5) *
          2,
        -1,
        1
      );

      targetY = THREE.MathUtils.clamp(
        ((event.clientY - rect.top) /
          rect.height -
          0.5) *
          2,
        -1,
        1
      );

      if (pointerDown) {
        const delta = event.clientX - previousX;

        if (Math.abs(delta) > 2) {
          dragged = true;
        }

        velocityY = delta * 0.006;

        rotationY += velocityY;

        previousX = event.clientX;
      }
    };

    const endDrag = () => {
      pointerDown = false;
    };

    const onCanvasClick = () => {
      if (!dragged) {
        changeState();
      }

      dragged = false;
    };

    const onKeyDown = (event: KeyboardEvent) => {
      if (
        event.key === "Enter" ||
        event.key === " "
      ) {
        event.preventDefault();

        changeState();
      }

      if (event.key === "ArrowLeft") {
        rotationY -= 0.18;
      }

      if (event.key === "ArrowRight") {
        rotationY += 0.18;
      }
    };

    canvas.addEventListener(
      "pointerdown",
      onPointerDown
    );

    canvas.addEventListener(
      "pointermove",
      onPointerMove
    );

    canvas.addEventListener(
      "pointerup",
      endDrag
    );

    canvas.addEventListener(
      "pointercancel",
      endDrag
    );

    canvas.addEventListener(
      "click",
      onCanvasClick
    );

    canvas.addEventListener(
      "keydown",
      onKeyDown
    );

    // --------------------------------------------------
    // RESIZE OBSERVER
    // --------------------------------------------------

    const resize = () => {
      const width = Math.max(
        1,
        wrapper.clientWidth
      );

      const height = Math.max(
        1,
        wrapper.clientHeight
      );

      camera.aspect = width / height;

      camera.updateProjectionMatrix();

      renderer.setSize(
        width,
        height,
        false
      );
    };

    const resizeObserver = new ResizeObserver(
      resize
    );

    resizeObserver.observe(wrapper);

    resize();

    // --------------------------------------------------
    // ANIMATION CLOCK
    // --------------------------------------------------

    const clock = new THREE.Clock();

    // --------------------------------------------------
    // VISIBILITY OBSERVER
    // --------------------------------------------------

    const visibilityObserver = new IntersectionObserver(
      (entries) => {
        const visible =
          entries[0]?.isIntersecting ?? true;

        if (visible && !disposed) {
          clock.start();

          renderer.setAnimationLoop(animate);
        } else {
          renderer.setAnimationLoop(null);
        }
      },
      {
        threshold: 0.05,
      }
    );

    visibilityObserver.observe(wrapper);

    // --------------------------------------------------
    // MAIN ANIMATION LOOP
    // --------------------------------------------------

    const animate = () => {
      if (disposed) return;

      const delta = Math.min(
        clock.getDelta(),
        0.04
      );

      const time = clock.elapsedTime;

      const smooth = (
        current: number,
        target: number,
        speed: number
      ) => {
        return THREE.MathUtils.lerp(
          current,
          target,
          1 - Math.exp(-speed * delta)
        );
      };

      // -----------------------------------------------
      // MOUSE TRACKING
      // -----------------------------------------------

      pointerX = smooth(
        pointerX,
        targetX,
        5
      );

      pointerY = smooth(
        pointerY,
        targetY,
        5
      );

      lookX = pointerX;
      lookY = pointerY;

      if (
        Math.abs(pointerX - targetX) > 0.002 ||
        Math.abs(pointerY - targetY) > 0.002
      ) {
        eyesDirty = true;
      }

      // -----------------------------------------------
      // EYE BLINKING
      // -----------------------------------------------

      blinkClock += delta;

      if (blinkHold > 0) {
        blinkHold -= delta;

        blink = Math.min(
          1,
          blinkHold * 12
        );
      } else {
        blink = Math.max(
          0,
          blink - delta * 12
        );

        if (
          blinkClock >
          3.8 + Math.sin(time * 0.3) * 0.8
        ) {
          blinkClock = 0;

          blinkHold = 0.12;
        }
      }

      if (blink > 0) {
        eyesDirty = true;
      }

      if (eyesDirty) {
        drawEyes();

        eyeTexture.needsUpdate = true;
      }

      // -----------------------------------------------
      // MANUAL ROTATION ONLY
      // -----------------------------------------------

      if (!pointerDown) {
        velocityY *= Math.pow(
          0.90,
          delta * 60
        );

        rotationY += velocityY;
      }

      // No automatic 360-degree rotation.

      robot.rotation.y = rotationY;

      robot.rotation.x = smooth(
        robot.rotation.x,
        -pointerY * 0.07,
        4
      );

      // -----------------------------------------------
      // HEAD MOVEMENT
      // -----------------------------------------------

      headPivot.rotation.y = smooth(
        headPivot.rotation.y,
        pointerX * 0.17,
        6
      );

      headPivot.rotation.x = smooth(
        headPivot.rotation.x,
        -pointerY * 0.11,
        6
      );

      // -----------------------------------------------
      // BEHAVIORAL TRANSITIONS
      // -----------------------------------------------

      currentArmPose = smooth(
        currentArmPose,
        targetArmPose,
        4
      );

      // -----------------------------------------------
      // 3D SPEECH / MOUTH ANIMATION
      // -----------------------------------------------

      mouthCurrent = smooth(
        mouthCurrent,
        mouthTarget,
        speechActive ? 22 : 14
      );

      mouthGroup.scale.y = mouthCurrent;

      mouthGlowMaterial.opacity = speechActive
        ? 0.25 + mouthCurrent * 0.12
        : 0.08;

      // -----------------------------------------------
      // ROBOT BODY ANIMATION
      // -----------------------------------------------

      if (!reducedMotion) {
        // Floating.

        robot.position.y =
          -0.05 +
          Math.sin(time * 1.35) * 0.065;

        // Torso movement.

        torso.rotation.z =
          Math.sin(time * 0.8) * 0.012;

        // Head stabilization.

        headPivot.position.y =
          0.9 +
          Math.sin(time * 1.35 + 0.5) * 0.018;

        // Mechanical arm animation.

        arms[0].rotation.z =
          Math.sin(time * 1.1) * 0.025 +
          currentArmPose;

        arms[1].rotation.z =
          -Math.sin(time * 1.1 + 0.6) * 0.025 -
          currentArmPose;

        // Thinking behavior.

        headPivot.rotation.z = smooth(
          headPivot.rotation.z,
          state === "thinking" ? 0.055 : 0,
          3
        );

        // Reactor rings.

        rings.forEach((ring, index) => {
          ring.scale.setScalar(
            1 +
              Math.sin(
                time * 2.6 + index * 0.8
              ) *
                0.055
          );

          const material =
            ring.material as THREE.MeshBasicMaterial;

          material.opacity =
            0.35 +
            Math.sin(
              time * 2.2 + index
            ) *
              0.09;
        });

        // Energy core.

        engineCore.scale.y =
          1 +
          Math.sin(time * 4) * 0.12;

        beamMaterial.opacity =
          0.09 +
          Math.sin(time * 3) * 0.035;

        // Floating shadow.

        shadow.scale.setScalar(
          1 -
            Math.sin(time * 1.35) * 0.035
        );
      }

      // -----------------------------------------------
      // OPTICAL SENSOR PULSE
      // -----------------------------------------------

      const pulse =
        0.5 +
        Math.sin(time * 2.4) * 0.25;

      sensorGlow.scale.setScalar(
        1 + pulse * 0.2
      );

      // -----------------------------------------------
      // RENDER
      // -----------------------------------------------

      renderer.render(scene, camera);
    };

    // --------------------------------------------------
    // CLEANUP / ASTRO NAVIGATION
    // --------------------------------------------------

    const cleanup = () => {
      if (disposed) return;

      disposed = true;

      renderer.setAnimationLoop(null);

      resizeObserver.disconnect();

      visibilityObserver.disconnect();

      speech?.removeEventListener(
        "click",
        onSpeechClick
      );

      wrapper.removeEventListener(
        "sis-robot-speaking",
        onRobotSpeaking
      );

      canvas.removeEventListener(
        "pointerdown",
        onPointerDown
      );

      canvas.removeEventListener(
        "pointermove",
        onPointerMove
      );

      canvas.removeEventListener(
        "pointerup",
        endDrag
      );

      canvas.removeEventListener(
        "pointercancel",
        endDrag
      );

      canvas.removeEventListener(
        "click",
        onCanvasClick
      );

      canvas.removeEventListener(
        "keydown",
        onKeyDown
      );

      scene.traverse((object) => {
        if (object instanceof THREE.Mesh) {
          object.geometry.dispose();

          const materials = Array.isArray(
            object.material
          )
            ? object.material
            : [object.material];

          materials.forEach((material) => {
            material.dispose();
          });
        }
      });

      eyeTexture.dispose();

      renderer.dispose();

      wrapper.dataset.initialized = "false";
    };

    document.addEventListener(
      "astro:before-swap",
      cleanup,
      { once: true }
    );

    // --------------------------------------------------
    // START RENDERING
    // --------------------------------------------------

    renderer.setAnimationLoop(animate);
  };

  // ----------------------------------------------------
  // ASTRO INITIALIZATION
  // ----------------------------------------------------

  const initRobots = () => {
    document
      .querySelectorAll<HTMLElement>(
        "[data-sis-robot]"
      )
      .forEach(mountRobot);
  };

  initRobots();

  document.addEventListener(
    "astro:page-load",
    initRobots
  );
</script>

---
// SIS logo lockup (wordmark + machine "I"). Inline SVG so the wordmark can use the
// page's IBM Plex Sans font and switch colour with the theme / header state.
const { class: cls = '' } = Astro.props;
---
<svg class={`brand-logo ${cls}`} viewBox="0 0 92 46" role="img" aria-label="SIS — Smart Integration Systems" focusable="false">
  <g class="sis-word" font-family="'IBM Plex Sans', sans-serif" font-weight="700" font-size="47" letter-spacing="-2">
    <text x="0" y="40">S</text>
    <text x="62.2" y="40">S</text>
  </g>
  <g transform="translate(28.2 0)">
    <path d="M5 3H27L31 7.5V21L26 27H6L1 21V7.5Z" fill="#14141B" stroke="#FF2638" stroke-width="2.4" stroke-linejoin="miter"/>
    <path d="M5.4 10.6L13.4 12.2L12.6 16.8L6.6 15.4Z" fill="#FF2638"/>
    <path d="M26.6 10.6L18.6 12.2L19.4 16.8L25.4 15.4Z" fill="#FF2638"/>
    <path d="M12.5 22H19.5" stroke="#FF2638" stroke-width="1.3" opacity=".75"/>
    <path d="M11.5 29.6H20.5V40.6L18.4 43H13.6L11.5 40.6Z" fill="#FF2638"/>
  </g>
</svg>

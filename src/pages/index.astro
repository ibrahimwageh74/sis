    <!-- CLIENT INTERACTIVE, GRADUAL SCROLL & AUDIO SCRIPTS -->
    <script>
      // 1. THEME TOGGLE (LIGHT MODE USES #D3D3D3)
      const root = document.documentElement;
      const toggle = document.getElementById('themeToggle');
      const storedTheme = localStorage.getItem('sis-theme');
      const preferredDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = storedTheme || (preferredDark ? 'dark' : 'light');

      const updateToggle = () => {
        if (!toggle) return;
        const isDark = root.dataset.theme === 'dark';
        toggle.querySelector('.theme-icon').textContent = isDark ? '☀' : '☾';
        toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
      };
      updateToggle();

      if (toggle) {
        toggle.addEventListener('click', () => {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          localStorage.setItem('sis-theme', root.dataset.theme);
          updateToggle();
        });
      }

      // Year
      const yearEl = document.getElementById('year');
      if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

      // 2. GRADUAL SCROLL ANIMATION & TOP PROGRESS BAR
      const topScrollProgress = document.getElementById('topScrollProgress');
      const gradualElements = document.querySelectorAll('.scroll-gradual');
      const heroArt = document.getElementById('heroArt');
      const talkingRobotWrap = document.getElementById('talkingRobotWrap');

      const handleScrollGradual = () => {
        const scrollY = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress = maxScroll > 0 ? (scrollY / maxScroll) * 100 : 0;
        if (topScrollProgress) {
          topScrollProgress.style.width = `${progress}%`;
        }

        // Subtle gradual parallax on robots
        if (heroArt && scrollY < window.innerHeight) {
          heroArt.style.transform = `translateY(${scrollY * 0.08}px)`;
        }
      };

      window.addEventListener('scroll', handleScrollGradual, { passive: true });
      handleScrollGradual();

      // 2.5 SCROLL-DRIVEN AUTOMATION JOURNEY PIPELINE ANIMATION
      const journeySection = document.getElementById('journey');
      const journeyBeamFill = document.getElementById('journeyBeamFill');
      const telemetryPct = document.getElementById('telemetryPct');
      const telemetryStageName = document.getElementById('telemetryStageName');
      const telemetryThroughput = document.getElementById('telemetryThroughput');
      const telemetryLatency = document.getElementById('telemetryLatency');
      const telemetryHours = document.getElementById('telemetryHours');

      const stageCards = [
        document.getElementById('jstage1'),
        document.getElementById('jstage2'),
        document.getElementById('jstage3')
      ];

      const updateJourneyScroll = () => {
        if (!journeySection || !journeyBeamFill) return;
        const rect = journeySection.getBoundingClientRect();
        const sectionH = rect.height;
        const startOffset = window.innerHeight * 0.72;
        const progress = Math.min(1, Math.max(0, (startOffset - rect.top) / (sectionH + startOffset * 0.25)));

        const pct = Math.round(progress * 100);
        journeyBeamFill.style.height = `${pct}%`;
        if (telemetryPct) telemetryPct.textContent = `${pct}%`;

        let currentStage = 0;
        if (progress >= 0.7) {
          currentStage = 2;
          if (telemetryStageName) telemetryStageName.textContent = 'Stage 03: Autonomous Dispatch';
          if (telemetryThroughput) telemetryThroughput.textContent = '4,850 ops/sec';
          if (telemetryLatency) telemetryLatency.textContent = '12ms (Peak)';
          if (telemetryHours) telemetryHours.textContent = '24 hrs / week';
        } else if (progress >= 0.35) {
          currentStage = 1;
          if (telemetryStageName) telemetryStageName.textContent = 'Stage 02: Neural Engine Verified';
          if (telemetryThroughput) telemetryThroughput.textContent = '2,420 ops/sec';
          if (telemetryLatency) telemetryLatency.textContent = '28ms';
          if (telemetryHours) telemetryHours.textContent = '14 hrs / week';
        } else {
          currentStage = 0;
          if (telemetryStageName) telemetryStageName.textContent = 'Stage 01: Ingestion Active';
          if (telemetryThroughput) telemetryThroughput.textContent = '1,120 ops/sec';
          if (telemetryLatency) telemetryLatency.textContent = '18ms';
          if (telemetryHours) telemetryHours.textContent = '6 hrs / week';
        }

        stageCards.forEach((card, idx) => {
          if (!card) return;
          card.classList.toggle('is-active-stage', idx <= currentStage);
          // Apply layered depth classes to cards sitting underneath in the stack
          card.classList.remove('card-layer-under-1', 'card-layer-under-2');
          if (currentStage === 1 && idx === 0) {
            card.classList.add('card-layer-under-1');
          } else if (currentStage === 2) {
            if (idx === 0) card.classList.add('card-layer-under-2');
            if (idx === 1) card.classList.add('card-layer-under-1');
          }
        });
      };

      window.addEventListener('scroll', updateJourneyScroll, { passive: true });
      updateJourneyScroll();

      // Progressive Intersection Observer for gradual entry
      const scrollObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
          }
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -40px 0px' });

      gradualElements.forEach(el => scrollObserver.observe(el));

      // 3. 3D HERO ROBOT PARALLAX & CLICK INTERACTION (EXACT PHOTO CHARACTER)
      const robotStage = document.getElementById('robotStage');
      const robotImageWrap = document.getElementById('robotImageWrap');
      const speechBubble = document.getElementById('robotSpeechBubble');
      const speechText = document.getElementById('speechText');

      if (heroArt && robotStage && window.matchMedia('(pointer:fine)').matches) {
        heroArt.addEventListener('pointermove', (e) => {
          const rect = heroArt.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          robotStage.style.transform = `perspective(1000px) rotateX(${ -y * 18 }deg) rotateY(${ x * 22 }deg) translateZ(15px)`;
        });

        heroArt.addEventListener('pointerleave', () => {
          robotStage.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateZ(0px)';
        });
      }

      const heroQuotes = [
        "🚀 Repulsor lift at 100%! Ready to automate your workflows.",
        "⚡ Fact: SIS automations save an average of 18 hours/week per teammate!",
        "🎯 Found 3 manual spreadsheets that need intelligent automation!",
        "💡 Listen to my live spoken quote in Section 03 below!",
        "💬 Click 'Ask Spark' at the bottom right to chat with me anytime!"
      ];
      let heroQuoteIdx = 0;

      if (robotStage) {
        robotStage.addEventListener('click', () => {
          heroQuoteIdx = (heroQuoteIdx + 1) % heroQuotes.length;
          if (speechText) speechText.textContent = heroQuotes[heroQuoteIdx];
          if (robotImageWrap) {
            robotImageWrap.style.animation = 'none';
            robotImageWrap.offsetHeight;
            robotImageWrap.style.animation = 'robot-float 1.5s ease-in-out';
          }
        });
      }

      setInterval(() => {
        heroQuoteIdx = (heroQuoteIdx + 1) % heroQuotes.length;
        if (speechText) speechText.textContent = heroQuotes[heroQuoteIdx];
      }, 6500);

      // System Status Label cycling
      const systemStatusLabel = document.getElementById('systemStatusLabel');
      const systemStatusText = document.getElementById('systemStatusText');
      const statusModes = [
        "SYSTEM ONLINE · 100%",
        "TURBO ENGINE · ACTIVE",
        "NEURAL COGNITION · SYNCED"
      ];
      let statusModeIdx = 0;
      if (systemStatusLabel && systemStatusText) {
        systemStatusLabel.addEventListener('click', () => {
          statusModeIdx = (statusModeIdx + 1) % statusModes.length;
          systemStatusText.textContent = statusModes[statusModeIdx];
        });
        setInterval(() => {
          statusModeIdx = (statusModeIdx + 1) % statusModes.length;
          systemStatusText.textContent = statusModes[statusModeIdx];
        }, 8000);
      }

      // 4. AUTONOMOUS WORKFLOW TRANSFORMER (SELF-RUNNING)
      const tasksContainer = document.getElementById('tasksContainer');
      const automatedContainer = document.getElementById('automatedContainer');
      const pendingCountBadge = document.getElementById('pendingCountBadge');
      const automatedCountBadge = document.getElementById('automatedCountBadge');
      const automateAllBtn = document.getElementById('automateAllBtn');
      const resetTasksBtn = document.getElementById('resetTasksBtn');

      const initialTasks = [
        { id: '1', title: 'Customer Email Triage', flow: 'Auto-categorized & drafted via AI in 0.2s' },
        { id: '2', title: 'Manual Spreadsheet Sync', flow: 'Real-time two-way database webhooks' },
        { id: '3', title: 'CRM Lead Data Entry', flow: 'AI agent enriches and logs automatically' },
        { id: '4', title: 'Follow-up Reminders', flow: 'Smart multi-channel triggers sent on schedule' },
        { id: '5', title: 'Invoice & Receipt Matching', flow: 'Optical extraction & Stripe reconciliation' },
      ];

      function updateCounts() {
        const remaining = tasksContainer ? tasksContainer.children.length : 0;
        const done = automatedContainer ? automatedContainer.children.length : 0;
        if (pendingCountBadge) pendingCountBadge.textContent = `${remaining} Tasks Pending`;
        if (automatedCountBadge) automatedCountBadge.textContent = `${done} Active Flows`;
      }

      function automateTask(chip: HTMLElement) {
        if (!chip || !automatedContainer) return;
        const id = chip.dataset.id;
        const taskData = initialTasks.find(t => t.id === id);
        chip.style.opacity = '0';
        chip.style.transform = 'scale(0.8)';
        setTimeout(() => {
          chip.remove();
          const item = document.createElement('div');
          item.className = 'automated-task-item';
          item.dataset.id = id;
          item.innerHTML = `
            <span>⚡ ${taskData ? taskData.title : 'Automated Workflow'}</span>
            <span class="tag-done">✓ AUTOMATED</span>
          `;
          automatedContainer.appendChild(item);
          updateCounts();
        }, 200);
      }

      function resetTransformationBoard() {
        if (!tasksContainer || !automatedContainer) return;
        tasksContainer.innerHTML = '';
        automatedContainer.innerHTML = '';
        initialTasks.forEach(t => {
          const chip = document.createElement('div');
          chip.className = 'interactive-task-chip';
          chip.dataset.id = t.id;
          chip.innerHTML = `<span>${t.title}</span><span class="chip-action">Automating...</span>`;
          tasksContainer.appendChild(chip);
        });
        updateCounts();
      }

      let userInteractedWithTasks = false;
      let autoTransformTimer: any = null;

      function runAutoTransformationLoop() {
        if (userInteractedWithTasks) return;
        if (tasksContainer && tasksContainer.children.length > 0) {
          const nextChip = tasksContainer.querySelector('.interactive-task-chip') as HTMLElement;
          if (nextChip) {
            automateTask(nextChip);
            autoTransformTimer = setTimeout(runAutoTransformationLoop, 1700);
          }
        } else {
          autoTransformTimer = setTimeout(() => {
            if (!userInteractedWithTasks) {
              resetTransformationBoard();
              autoTransformTimer = setTimeout(runAutoTransformationLoop, 1200);
            }
          }, 6000);
        }
      }

      const whatWeDoSection = document.getElementById('what-we-do');
      if (whatWeDoSection) {
        const autoObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !userInteractedWithTasks && !autoTransformTimer) {
              autoTransformTimer = setTimeout(runAutoTransformationLoop, 800);
            }
          });
        }, { threshold: 0.25 });
        autoObserver.observe(whatWeDoSection);
      }

      if (tasksContainer) {
        tasksContainer.addEventListener('click', (e) => {
          userInteractedWithTasks = true;
          if (autoTransformTimer) clearTimeout(autoTransformTimer);
          const chip = (e.target as HTMLElement).closest('.interactive-task-chip') as HTMLElement;
          if (chip) automateTask(chip);
        });
      }

      if (automateAllBtn) {
        automateAllBtn.addEventListener('click', () => {
          userInteractedWithTasks = true;
          if (autoTransformTimer) clearTimeout(autoTransformTimer);
          if (!tasksContainer) return;
          const chips = Array.from(tasksContainer.querySelectorAll('.interactive-task-chip')) as HTMLElement[];
          chips.forEach((chip, i) => {
            setTimeout(() => automateTask(chip), i * 150);
          });
        });
      }

      if (resetTasksBtn) {
        resetTasksBtn.addEventListener('click', () => {
          userInteractedWithTasks = true;
          if (autoTransformTimer) clearTimeout(autoTransformTimer);
          resetTransformationBoard();
        });
      }

      // 5. SERVICE 1: LIVE CHAT DEMO (AUTONOMOUS DEMO STREAM)
      const demoChatHistory = document.getElementById('demoChatHistory');
      const chatChips = document.querySelectorAll('.chat-quick-chips .chip-btn');

      const chatScenarios = [
        {
          q: 'Track my shipment #9102',
          a: '📦 Shipment #9102 is Out for Delivery via FedEx. Estimated delivery: today at 2:15 PM.'
        },
        {
          q: 'Can SIS sync Stripe invoices to QuickBooks?',
          a: '⚡ Automated daily sync is active! Invoices reconcile with zero manual data entry.'
        },
        {
          q: 'How fast do AI responses execute?',
          a: '🚀 Real-time execution in 0.12s with 99.8% precision across all connected channels.'
        }
      ];

      let chatScenarioIdx = 0;
      let userClickedChat = false;

      function simulateChatQuery(question: string, answer: string) {
        if (!demoChatHistory) return;
        while (demoChatHistory.children.length > 3) {
          demoChatHistory.removeChild(demoChatHistory.children[0]);
        }

        const userMsg = document.createElement('div');
        userMsg.className = 'chat-msg msg-user';
        userMsg.textContent = question;
        demoChatHistory.appendChild(userMsg);
        demoChatHistory.scrollTop = demoChatHistory.scrollHeight;

        const typingMsg = document.createElement('div');
        typingMsg.className = 'chat-msg msg-bot';
        typingMsg.innerHTML = '<span>Spark is typing...</span>';
        demoChatHistory.appendChild(typingMsg);

        setTimeout(() => {
          typingMsg.innerHTML = `<span>${answer}</span>`;
          demoChatHistory.scrollTop = demoChatHistory.scrollHeight;
        }, 550);
      }

      setInterval(() => {
        if (!userClickedChat) {
          const scenario = chatScenarios[chatScenarioIdx];
          simulateChatQuery(scenario.q, scenario.a);
          chatScenarioIdx = (chatScenarioIdx + 1) % chatScenarios.length;
        }
      }, 5500);

      chatChips.forEach(btn => {
        btn.addEventListener('click', () => {
          userClickedChat = true;
          const question = btn.getAttribute('data-chat');
          if (question) {
            const match = chatScenarios.find(s => s.q === question);
            simulateChatQuery(question, match ? match.a : 'I can automate that right now!');
          }
        });
      });

      // 6. SERVICE 2: AUTONOMOUS CONTINUOUS PIPELINE SIMULATOR
      const runPipelineBtn = document.getElementById('runPipelineBtn');
      const pipelineLog = document.getElementById('pipelineLog');
      const pNodes = [
        document.getElementById('pn1'),
        document.getElementById('pn2'),
        document.getElementById('pn3'),
        document.getElementById('pn4')
      ];
      const pConnectors = [
        document.getElementById('pc1'),
        document.getElementById('pc2'),
        document.getElementById('pc3')
      ];

      let isPipelineRunning = false;

      function runPipelineCycle() {
        if (isPipelineRunning) return;
        isPipelineRunning = true;

        pNodes.forEach((n, i) => i !== 0 && n?.classList.remove('active'));
        pConnectors.forEach(c => c?.classList.remove('flow-active'));

        const steps = [
          { text: '⚡ Webhook event received from intake form', delay: 350 },
          { text: '🧠 AI parsed structured JSON payload', delay: 750 },
          { text: '🔄 Synchronized customer record with Salesforce', delay: 1150 },
          { text: '📢 Dispatched alert to #operations channel (194ms)', delay: 1550 },
        ];

        steps.forEach((step, i) => {
          setTimeout(() => {
            if (pipelineLog) pipelineLog.textContent = step.text;
            if (pNodes[i]) pNodes[i]?.classList.add('active');
            if (i > 0 && pConnectors[i - 1]) pConnectors[i - 1]?.classList.add('flow-active');

            if (i === steps.length - 1) {
              setTimeout(() => {
                if (pipelineLog) pipelineLog.textContent = '✓ Pipeline completed in 194ms (Status: 200 OK)';
                isPipelineRunning = false;
              }, 600);
            }
          }, step.delay);
        });
      }

      setInterval(runPipelineCycle, 4200);

      if (runPipelineBtn) {
        runPipelineBtn.addEventListener('click', () => {
          runPipelineCycle();
        });
      }

      // 7. SERVICE 3: SYSTEM INTEGRATIONS AUTO-PULSE
      const integrationPills = document.querySelectorAll('.integration-pill');
      const hubActiveCount = document.getElementById('hubActiveCount');
      const hubEventsCount = document.getElementById('hubEventsCount');

      let eventCounter = 2840;
      setInterval(() => {
        eventCounter += Math.floor(Math.random() * 8) + 1;
        if (hubEventsCount) hubEventsCount.textContent = `● ${eventCounter.toLocaleString()} events/min`;

        const randomIdx = Math.floor(Math.random() * integrationPills.length);
        const pill = integrationPills[randomIdx] as HTMLElement;
        if (pill) {
          pill.style.transform = 'scale(1.1)';
          setTimeout(() => { pill.style.transform = 'scale(1)'; }, 300);
        }
      }, 2500);

      integrationPills.forEach(pill => {
        pill.addEventListener('click', () => {
          pill.classList.toggle('connected');
          const connected = document.querySelectorAll('.integration-pill.connected').length;
          if (hubActiveCount) {
            hubActiveCount.textContent = `${connected} Systems Synchronized`;
          }
        });
      });

      // 8. TALKING ROBOT SECTION WITH SOUND ON/OFF & ONCE-PER-SESSION AUTO-PLAY
      const quoteWordsContainer = document.getElementById('quoteWordsContainer');
      const talkingMouth = document.getElementById('talkingMouth');
      const talkingSoundwaves = document.getElementById('talkingSoundwaves');
      const quoteStatusText = document.getElementById('quoteStatusText');
      const quoteSubtext = document.getElementById('quoteSubtext');
      const btnReplayQuote = document.getElementById('btnReplayQuote');
      const btnNextQuote = document.getElementById('btnNextQuote');
      const btnAudioToggle = document.getElementById('btnAudioToggle');
      const audioToggleText = document.getElementById('audioToggleText');

      const sparkQuotes = [
        "The true power of AI automation is not doing less work — it is unlocking the capability to do what was once thought impossible.",
        "When repetitive tasks run themselves, your people finally have the room to think, invent, and lead.",
        "Every modern enterprise will eventually become an AI-orchestrated company. The only question is whether you architect your advantage today or scramble to catch up tomorrow."
      ];

      let currentQuoteIdx = 0;
      let isQuoteSpeaking = false;
      let quoteWordTimeout: any = null;
      let audioEnabled = true;

      // Web Audio Synthesizer with safe cross-browser audio context
      let audioCtx: any = null;

      function getOrCreateAudioContext() {
        if (!audioCtx) {
          const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
          if (AudioContextClass) {
            audioCtx = new AudioContextClass();
          }
        }
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      function playRobotSpeechTone(frequency = 540) {
        if (!audioEnabled) return;
        try {
          const ctx = getOrCreateAudioContext();
          if (!ctx) return;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(frequency, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(frequency + 70, ctx.currentTime + 0.08);

          gain.gain.setValueAtTime(0.045, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.085);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.085);
        } catch (e) {
          // Audio policy safe
        }
      }

      const phonemeClasses = ['phoneme-open', 'phoneme-wide', 'phoneme-round', 'phoneme-small'];

      // Render static words when not animating
      function renderQuoteStatic(index: number) {
        if (!quoteWordsContainer) return;
        const words = sparkQuotes[index].split(' ');
        quoteWordsContainer.innerHTML = '';
        words.forEach((w, i) => {
          const span = document.createElement('span');
          span.className = 'quote-word revealed';
          span.id = `qword-${i}`;
          span.textContent = w;
          quoteWordsContainer.appendChild(span);
        });
        if (quoteStatusText) quoteStatusText.textContent = 'DIRECTIVE SYNCHRONIZED · READY';
        if (quoteSubtext) quoteSubtext.textContent = `SYSTEM BROADCAST · DIRECTIVE 0${index + 1} OF 0${sparkQuotes.length}`;
      }

      function speakQuote(index: number) {
        if (!quoteWordsContainer) return;
        if (quoteWordTimeout) clearTimeout(quoteWordTimeout);

        // Cancel previous speech if browser synthesis was speaking
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel();
        }

        isQuoteSpeaking = true;
        currentQuoteIdx = index;
        const text = sparkQuotes[index];
        const words = text.split(' ');

        if (quoteStatusText) quoteStatusText.textContent = 'TRANSMITTING VOICE · LIVE';
        if (quoteSubtext) quoteSubtext.textContent = `SYSTEM BROADCAST · DIRECTIVE 0${index + 1} OF 0${sparkQuotes.length}`;

        // Prepare words
        quoteWordsContainer.innerHTML = '';
        words.forEach((w, i) => {
          const span = document.createElement('span');
          span.className = 'quote-word';
          span.id = `qword-${i}`;
          span.textContent = w;
          quoteWordsContainer.appendChild(span);
        });

        if (talkingRobotWrap) {
          talkingRobotWrap.classList.add('is-speaking');
        }

        let wordIdx = 0;

        function stepWord() {
          if (wordIdx < words.length) {
            // Update previous word
            if (wordIdx > 0) {
              const prev = document.getElementById(`qword-${wordIdx - 1}`);
              if (prev) {
                prev.classList.remove('speaking-now');
                prev.classList.add('revealed');
              }
            }

            // Highlight current active word
            const curr = document.getElementById(`qword-${wordIdx}`);
            if (curr) {
              curr.classList.add('speaking-now');
            }

            // Animate mouth synchronized with word
            if (talkingMouth) {
              talkingMouth.className = 'talking-mouth-overlay ' + phonemeClasses[wordIdx % phonemeClasses.length];
            }

            // Radiate soundwave pulse
            if (talkingSoundwaves) {
              talkingSoundwaves.classList.remove('pulse');
              talkingSoundwaves.offsetHeight; // force reflow
              talkingSoundwaves.classList.add('pulse');
            }

            // Natural simple talking head gestures on rig (image and mouth stay unified)
            const talkingRobotRig = document.getElementById('talkingRobotRig');
            if (talkingRobotRig) {
              talkingRobotRig.style.transform = (wordIdx % 2 === 0)
                ? 'translateY(-3px) rotate(-1.2deg)'
                : 'translateY(1px) rotate(1deg)';
            }

            // Audio blip in sync
            const pitch = 480 + ((wordIdx * 45) % 240);
            playRobotSpeechTone(pitch);

            wordIdx++;
            const lastChar = words[wordIdx - 1]?.slice(-1);
            const pause = (lastChar === '.' || lastChar === '—' || lastChar === ',') ? 340 : 175;
            quoteWordTimeout = setTimeout(stepWord, pause);
          } else {
            // Finished speaking quote
            if (wordIdx > 0) {
              const last = document.getElementById(`qword-${wordIdx - 1}`);
              if (last) {
                last.classList.remove('speaking-now');
                last.classList.add('revealed');
              }
            }
            if (talkingMouth) {
              talkingMouth.className = 'talking-mouth-overlay idle';
            }
            if (talkingRobotWrap) {
              talkingRobotWrap.style.transform = 'scale(1) translateY(0px)';
              talkingRobotWrap.classList.remove('is-speaking');
            }
            const talkingRobotRig = document.getElementById('talkingRobotRig');
            if (talkingRobotRig) {
              talkingRobotRig.style.transform = 'translateY(0) rotate(0deg)';
            }
            if (quoteStatusText) {
              quoteStatusText.textContent = '✓ TRANSMISSION COMPLETE · READY';
            }
            isQuoteSpeaking = false;
            // NOTE: DOES NOT auto-advance to next quote! Plays once per user directive.
          }
        }

        stepWord();
      }

      // SESSION STORAGE RULE:
      // Auto-plays ONE TIME when user gets on section for the first time opening browser.
      // Cleared when user closes & reopens browser.
      const QUOTE_SESSION_KEY = 'sis_spark_quote_session_played';
      const quoteSection = document.getElementById('quote-section');

      // Initialize with static quote visible immediately
      renderQuoteStatic(0);

      if (quoteSection) {
        const quoteObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const hasPlayedThisSession = sessionStorage.getItem(QUOTE_SESSION_KEY);
              if (!hasPlayedThisSession) {
                // First time in this browser session! Play once.
                sessionStorage.setItem(QUOTE_SESSION_KEY, 'true');
                speakQuote(0);
              }
            }
          });
        }, { threshold: 0.22 });
        quoteObserver.observe(quoteSection);
      }

      // Replay Quote Button (Always plays on demand)
      if (btnReplayQuote) {
        btnReplayQuote.addEventListener('click', () => {
          speakQuote(currentQuoteIdx);
        });
      }

      // Next Quote Button (Cycles and plays on demand)
      if (btnNextQuote) {
        btnNextQuote.addEventListener('click', () => {
          const next = (currentQuoteIdx + 1) % sparkQuotes.length;
          speakQuote(next);
        });
      }

      // Sound On / Off Button - Instant response & audible feedback
      if (btnAudioToggle) {
        btnAudioToggle.addEventListener('click', (e) => {
          e.preventDefault();
          audioEnabled = !audioEnabled;
          getOrCreateAudioContext();

          if (audioEnabled) {
            btnAudioToggle.className = 'btn-quote-control sound-active';
            btnAudioToggle.innerHTML = '<span class="status-dot online" style="width:6px;height:6px;margin-right:2px;"></span> <span>Sound: ON</span>';
            // Audible high-tech confirmation chime
            playRobotSpeechTone(520);
            setTimeout(() => playRobotSpeechTone(780), 90);
          } else {
            btnAudioToggle.className = 'btn-quote-control sound-muted';
            btnAudioToggle.innerHTML = '<span>🔇 Sound: OFF</span>';
            if ('speechSynthesis' in window) {
              window.speechSynthesis.cancel();
            }
          }
        });
      }

      // 9. ROI CALCULATOR WITH AUTONOMOUS PREVIEW
      const teamSizeSlider = document.getElementById('teamSizeSlider') as HTMLInputElement;
      const hoursSlider = document.getElementById('hoursSlider') as HTMLInputElement;
      const rateSlider = document.getElementById('rateSlider') as HTMLInputElement;

      const teamSizeVal = document.getElementById('teamSizeVal');
      const hoursVal = document.getElementById('hoursVal');
      const rateVal = document.getElementById('rateVal');

      const calcHoursSaved = document.getElementById('calcHoursSaved');
      const calcDollarSaved = document.getElementById('calcDollarSaved');
      const calcRemarkText = document.getElementById('calcRemarkText');

      function updateCalculator() {
        if (!teamSizeSlider || !hoursSlider || !rateSlider) return;
        const team = parseInt(teamSizeSlider.value, 10);
        const hrs = parseInt(hoursSlider.value, 10);
        const rate = parseInt(rateSlider.value, 10);

        if (teamSizeVal) teamSizeVal.textContent = `${team} people`;
        if (hoursVal) hoursVal.textContent = `${hrs} hrs/wk`;
        if (rateVal) rateVal.textContent = `$${rate} / hr`;

        const annualHours = Math.round(team * hrs * 50 * 0.72);
        const annualDollars = Math.round(annualHours * rate);

        if (calcHoursSaved) calcHoursSaved.textContent = `${annualHours.toLocaleString()} hrs`;
        if (calcDollarSaved) calcDollarSaved.textContent = `$${annualDollars.toLocaleString()}`;

        if (calcRemarkText) {
          if (annualDollars > 150000) {
            calcRemarkText.innerHTML = `🔥 <strong>Spark:</strong> "Incredible! Over $${annualDollars.toLocaleString()} in reclaimed productivity every year. Let's build your pipeline!"`;
          } else {
            calcRemarkText.innerHTML = `🚀 <strong>Spark:</strong> "That's ${annualHours.toLocaleString()} hours your team gets back every year for strategic projects!"`;
          }
        }
      }

      let userTouchedCalculator = false;
      [teamSizeSlider, hoursSlider, rateSlider].forEach(slider => {
        if (slider) {
          slider.addEventListener('input', () => {
            userTouchedCalculator = true;
            updateCalculator();
          });
        }
      });
      updateCalculator();

      const calcSection = document.getElementById('calculator');
      if (calcSection) {
        let calcAnimated = false;
        const calcObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting && !calcAnimated && !userTouchedCalculator) {
              calcAnimated = true;
              let currentVal = 12;
              const targetVal = 24;
              const animTimer = setInterval(() => {
                if (userTouchedCalculator) {
                  clearInterval(animTimer);
                  return;
                }
                currentVal += 1;
                teamSizeSlider.value = currentVal.toString();
                updateCalculator();
                if (currentVal >= targetVal) clearInterval(animTimer);
              }, 80);
            }
          });
        }, { threshold: 0.3 });
        calcObserver.observe(calcSection);
      }

      // 10. PROCESS TRACK (AUTONOMOUS STAGE ADVANCEMENT)
      const processStepsElements = document.querySelectorAll('.process-step');
      const mascotGuideText = document.getElementById('mascotGuideText');
      const processProgressBar = document.getElementById('processProgressBar');
      const processTrack = document.getElementById('processTrack');

      let currentProcessIdx = 0;
      let processHovered = false;

      function setProcessStep(index: number) {
        currentProcessIdx = index;
        processStepsElements.forEach((s, idx) => {
          s.classList.toggle('active-step', idx === index);
        });
        const activeEl = processStepsElements[index];
        const tip = activeEl ? activeEl.getAttribute('data-tip') : '';
        if (mascotGuideText && tip) {
          mascotGuideText.innerHTML = `<strong>Phase 0${index + 1} Guidance:</strong> ${tip}`;
        }
        if (processProgressBar) {
          processProgressBar.style.transform = `scaleX(${(index + 1) / processStepsElements.length})`;
        }
      }

      setInterval(() => {
        if (!processHovered) {
          const nextIdx = (currentProcessIdx + 1) % processStepsElements.length;
          setProcessStep(nextIdx);
        }
      }, 3800);

      if (processTrack) {
        processTrack.addEventListener('pointerenter', () => { processHovered = true; });
        processTrack.addEventListener('pointerleave', () => { processHovered = false; });
      }

      processStepsElements.forEach((el, index) => {
        el.addEventListener('click', () => {
          setProcessStep(index);
        });
      });

      // 11. CONSULTATION FORM
      const consultationForm = document.getElementById('consultationForm');
      const formSuccessMsg = document.getElementById('formSuccessMsg');
      const formTags = document.querySelectorAll('.form-tag');

      formTags.forEach(tag => {
        tag.addEventListener('click', () => {
          formTags.forEach(t => t.classList.remove('active'));
          tag.classList.add('active');
        });
      });

      if (consultationForm) {
        consultationForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const submitBtn = document.getElementById('formSubmitBtn');
          if (submitBtn) {
            submitBtn.textContent = 'Transmitting Blueprint Request...';
            setTimeout(() => {
              consultationForm.reset();
              submitBtn.style.display = 'none';
              if (formSuccessMsg) formSuccessMsg.style.display = 'block';
            }, 600);
          }
        });
      }

      // 12. FLOATING ROBOT COPILOT CHATBOT
      const copilotLauncher = document.getElementById('copilotLauncher');
      const copilotWindow = document.getElementById('copilotWindow');
      const copilotCloseBtn = document.getElementById('copilotCloseBtn');
      const copilotForm = document.getElementById('copilotForm');
      const copilotInput = document.getElementById('copilotInput') as HTMLInputElement;
      const copilotMessages = document.getElementById('copilotMessages');
      const copilotChips = document.querySelectorAll('.copilot-chip');

      const copilotKnowledge: Record<string, string> = {
        'What tools can you integrate with?': 'We integrate with any modern system with an API or webhook: Slack, Salesforce, HubSpot, Stripe, Notion, PostgreSQL, Zendesk, Jira, and custom ERPs.',
        'How fast can we launch an agent?': 'Most single-process agents deploy within 7–14 days. Complex multi-system pipelines usually go live in 3 to 4 weeks.',
        'How does pricing work?': 'We work on transparent project-based blueprints with optional monthly maintenance & optimization SLAs. No hidden surprise compute fees.',
        'default': 'Great question! Spark can configure custom autonomous workflows for your exact use case. Fill out the consultation form below or email hello@sis.agency for a personalized roadmap!'
      };

      if (copilotLauncher && copilotWindow) {
        copilotLauncher.addEventListener('click', () => {
          copilotWindow.classList.toggle('hidden');
          if (!copilotWindow.classList.contains('hidden') && copilotInput) {
            copilotInput.focus();
          }
        });
      }

      if (copilotCloseBtn && copilotWindow) {
        copilotCloseBtn.addEventListener('click', () => {
          copilotWindow.classList.add('hidden');
        });
      }

      function addCopilotMessage(sender: 'user' | 'bot', text: string) {
        if (!copilotMessages) return;
        const msg = document.createElement('div');
        msg.className = `chat-msg msg-${sender}`;
        msg.innerHTML = `<span>${text}</span>`;
        copilotMessages.appendChild(msg);
        copilotMessages.scrollTop = copilotMessages.scrollHeight;
      }

      copilotChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const q = chip.getAttribute('data-q');
          if (!q) return;
          addCopilotMessage('user', q);
          setTimeout(() => {
            addCopilotMessage('bot', copilotKnowledge[q] || copilotKnowledge['default']);
          }, 400);
        });
      });

      if (copilotForm && copilotInput) {
        copilotForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const q = copilotInput.value.trim();
          if (!q) return;
          addCopilotMessage('user', q);
          copilotInput.value = '';

          setTimeout(() => {
            const matchedKey = Object.keys(copilotKnowledge).find(k =>
              q.toLowerCase().includes(k.toLowerCase()) || k.toLowerCase().includes(q.toLowerCase())
            );
            addCopilotMessage('bot', matchedKey ? copilotKnowledge[matchedKey] : copilotKnowledge['default']);
          }, 450);
        });
      }

      // 6. FOOTER NEWSLETTER FORM SUBMISSION
      const footerNewsletterForm = document.getElementById('footerNewsletterForm');
      const newsletterSuccess = document.getElementById('newsletterSuccess');
      if (footerNewsletterForm) {
        footerNewsletterForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const emailInput = document.getElementById('newsletterEmail') as HTMLInputElement | null;
          if (emailInput && emailInput.value) {
            emailInput.value = '';
            if (newsletterSuccess) {
              newsletterSuccess.style.display = 'block';
              setTimeout(() => {
                if (newsletterSuccess) newsletterSuccess.style.display = 'none';
              }, 4000);
            }
          }
        });
      }
    </script>
  </body>
</html>

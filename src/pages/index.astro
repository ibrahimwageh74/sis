---
import '../styles/global.css';

const services = [
  {
    n: '01',
    tag: 'Conversations',
    title: 'AI Customer Support',
    desc: 'Respond to customers across all your channels 24/7 with zero latency, brand alignment, and automated ticket resolution.',
  },
  {
    n: '02',
    tag: 'Operations',
    title: 'Business Process Automation',
    desc: 'Connect repetitive tasks, tools, and handoffs into self-running pipelines so your team can focus on high-impact work.',
  },
  {
    n: '03',
    tag: 'Intelligence',
    title: 'AI Agents & Integrations',
    desc: 'Custom autonomous assistants that connect with your databases, CRM, and APIs while strictly respecting your business logic.',
  },
];

const processSteps = [
  {
    n: '01',
    title: 'Discover',
    icon: '⌕',
    desc: 'We map out your current workflows, finding bottlenecks and repetitive manual overhead.',
    caption: 'UNDERSTAND THE NEED',
    tip: 'In this phase, we analyze where your team spends 10+ hours a week on repetitive tasks.',
  },
  {
    n: '02',
    title: 'Design',
    icon: '⌘',
    desc: 'We architect a lean, custom automation blueprint tailored to your tech stack and goals.',
    caption: 'PLAN THE SYSTEM',
    tip: 'We model the exact data flow, error handling, and API connections before writing any code.',
  },
  {
    n: '03',
    title: 'Build',
    icon: '⚙',
    desc: 'We implement intelligent AI agents, test edge cases, and integrate with your existing systems.',
    caption: 'MAKE IT WORK',
    tip: 'We stress-test prompt resilience, rate limits, and fallback paths for 99.9% reliability.',
  },
  {
    n: '04',
    title: 'Deploy',
    icon: '↗',
    desc: 'We launch into production with live telemetry, training your team and fine-tuning performance.',
    caption: 'SCALE WITH CONFIDENCE',
    tip: 'Continuous monitoring ensures response accuracy and seamless operational velocity.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#D3D3D3" />
    <meta name="description" content="SIS builds interactive AI agents and autonomous business automation systems that help modern teams work smarter and scale." />
    <title>SIS — AI Agents & Autonomous Business Automation</title>
    <link rel="icon" type="image/png" href="/robot-avatar.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Top Global Scroll Progress Bar -->
    <div class="top-scroll-progress" id="topScrollProgress"></div>

    <div class="site-shell">
      <!-- NAVIGATION -->
      <header class="nav-wrap">
        <a class="brand" href="#top" aria-label="SIS Home">
          <img src="/sis-logo.png" alt="SIS" class="brand-logo" />
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="#what-we-do">What We Do</a>
          <a href="#services">Services</a>
          <a href="#journey">Journey</a>
          <a href="#quote-section">AI Voice</a>
          <a href="#calculator">ROI Calculator</a>
          <a href="#process">Our Process</a>
        </nav>
        <div class="nav-actions">
          <button class="theme-toggle" id="themeToggle" aria-label="Switch theme" title="Switch dark/light mode">
            <span class="theme-icon">☾</span>
          </button>
          <a class="nav-cta" href="#contact">
            Let's talk <span>↗</span>
          </a>
        </div>
      </header>

      <main id="top">
        <!-- HERO SECTION -->
        <section class="hero section-pad scroll-gradual">
          <div class="hero-copy">
            <div class="eyebrow">
              <span class="eyebrow-dot"></span> AUTONOMOUS AGENTS · BUSINESS AUTOMATION
            </div>
            <h1>
              Make work<br />
              <span class="outline-word">move</span> <span class="red-word">smarter.</span>
            </h1>
            <p class="hero-lede">
              We turn complex business processes into intelligent systems that help your team move faster, serve better, and grow with confidence.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#quote-section">
                Hear from Spark <span>↘</span>
              </a>
              <a class="button button-secondary" href="#calculator">
                Calculate savings <span>→</span>
              </a>
            </div>
            <div class="hero-proof">
              <span class="proof-line"></span>
              <span>Tested on 10,000+ automated workflows. Designed for what's next.</span>
            </div>
          </div>

          <!-- AUTHENTIC 3D ROBOT MASCOT HERO ART -->
          <div class="hero-art" id="heroArt" aria-label="SIS Robot Mascot Stage">
            <div class="orbit orbit-one"></div>
            <div class="orbit orbit-two"></div>
            <div class="orbit orbit-three"></div>
            <div class="hero-grid"></div>

            <div class="floating-label label-top" id="systemStatusLabel" title="Click to cycle robot modes">
              <span class="status-dot online"></span> <span id="systemStatusText">SYSTEM ONLINE · 100%</span>
            </div>

            <div class="robot-stage" id="robotStage" title="Click me to interact!">
              <!-- Interactive Speech Bubble -->
              <div class="robot-speech-bubble" id="robotSpeechBubble">
                <span class="speech-sparkle">✦</span>
                <span id="speechText">Hey! I'm Spark. Click me or hover around!</span>
              </div>

              <!-- Robot Image Container (Exact character from photo) -->
              <div class="robot-image-wrap" id="robotImageWrap">
                <img
                  src="/robot.png"
                  alt="SIS 3D Robot Mascot"
                  class="robot-mascot-img"
                  id="robotMascotImg"
                />
              </div>

              <!-- Luminous Repulsor Rings -->
              <div class="robot-repulsor" aria-hidden="true">
                <div class="repulsor-ring ring-1"></div>
                <div class="repulsor-ring ring-2"></div>
                <div class="repulsor-ring ring-3"></div>
              </div>
            </div>

            <div class="floating-label label-bottom" id="automationStatusLabel" title="Live automation status">
              <span class="mini-bars"><i></i><i></i><i></i></span>
              <span id="activityText">PIPELINE RUNNING · 24/7</span>
            </div>
          </div>

          <a class="scroll-cue" href="#what-we-do">
            <span class="scroll-wheel"></span> SCROLL TO EXPLORE
          </a>
        </section>

        <!-- SECTION 01: WHAT WE DO & SELF-RUNNING WORKFLOW TRANSFORMER -->
        <section class="intro section-pad section-pad-vert scroll-gradual" id="what-we-do">
          <div class="section-kicker">
            <span>01 / WHAT WE DO</span>
            <span class="kicker-rule"></span>
          </div>

          <div class="intro-layout">
            <h2>
              Less busywork.<br />
              <span class="muted-text">More</span> <span class="red-word">momentum.</span>
            </h2>
            <div class="intro-side">
              <p>
                Good automation doesn't add another complicated tool. It makes the tools and people you already have work seamlessly together.
              </p>
              <div class="robot-message">
                <div class="tiny-robot-avatar">
                  <img src="/robot-avatar.png" alt="Spark Avatar" />
                </div>
                <div>
                  <strong>Live Autonomous Simulation:</strong><br />
                  <span>Watch the workflow board below transform tasks automatically, or click any task to control it yourself!</span>
                </div>
              </div>
            </div>
          </div>

          <!-- INTERACTIVE TRANSFORMATION PLAYGROUND (AUTO-RUNNING) -->
          <div class="transformation-board scroll-gradual stagger-1">
            <div class="board-header">
              <div class="board-title">
                <span>⚡ Autonomous Workflow Transformer</span>
                <span class="badge-live-auto" id="autoStatusIndicator" style="font-size: 10px; background: var(--red-soft); color: var(--red); padding: 4px 8px; border-radius: 12px; font-weight: 700;">● AUTO-STREAMING</span>
              </div>
              <div class="board-controls">
                <button class="btn-pill" id="automateAllBtn">⚡ Automate All</button>
                <button class="btn-pill" id="resetTasksBtn">↺ Reset Board</button>
              </div>
            </div>

            <div class="transformation-grid">
              <!-- Left: Chaotic Manual Tasks -->
              <div class="board-pane" id="paneBefore">
                <div class="pane-badge">
                  <span>BEFORE SIS · MANUAL OVERHEAD</span>
                  <span id="pendingCountBadge">5 Tasks Pending</span>
                </div>
                <div class="interactive-tasks-container" id="tasksContainer">
                  <div class="interactive-task-chip" data-id="1">
                    <span>📩 Customer Email Triage</span>
                    <span class="chip-action">Automating...</span>
                  </div>
                  <div class="interactive-task-chip" data-id="2">
                    <span>📊 Manual Spreadsheet Sync</span>
                    <span class="chip-action">Automating...</span>
                  </div>
                  <div class="interactive-task-chip" data-id="3">
                    <span>👤 CRM Lead Data Entry</span>
                    <span class="chip-action">Automating...</span>
                  </div>
                  <div class="interactive-task-chip" data-id="4">
                    <span>⏰ Follow-up Reminders</span>
                    <span class="chip-action">Automating...</span>
                  </div>
                  <div class="interactive-task-chip" data-id="5">
                    <span>🧾 Invoice & Receipt Matching</span>
                    <span class="chip-action">Automating...</span>
                  </div>
                </div>
              </div>

              <!-- Middle: Flow Arrow -->
              <div class="board-middle">
                <div class="pulse-arrow">→</div>
                <small>SIS ENGINE</small>
              </div>

              <!-- Right: Automated Systems -->
              <div class="board-pane" id="paneAfter">
                <div class="pane-badge">
                  <span>WITH SIS · AUTONOMOUS FLOW</span>
                  <span id="automatedCountBadge" style="color: var(--green);">0 Active</span>
                </div>
                <div class="automated-tasks-container" id="automatedContainer">
                  <!-- Transformed items appear here -->
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 02: SERVICES WITH SELF-RUNNING LIVE DEMOS -->
        <section class="services section-pad section-pad-vert scroll-gradual" id="services">
          <div class="section-kicker">
            <span>02 / WHAT WE BUILD</span>
            <span class="kicker-rule"></span>
          </div>

          <div class="section-heading">
            <h2>
              Meet your new<br />
              <span class="red-word">unfair advantage.</span>
            </h2>
            <p>
              Interactive systems operating in continuous real-time preview. Watch each engine demonstrate its capabilities:
            </p>
          </div>

          <div class="service-grid">
            <!-- SERVICE 1: AI CUSTOMER SUPPORT CHAT DEMO (AUTO-LOOPING) -->
            <article class="service-card scroll-gradual stagger-1">
              <div class="card-top">
                <span>01 / CONVERSATIONS</span>
                <span class="card-arrow">↗</span>
              </div>
              <h3>AI Customer Support</h3>
              <p>Resolve customer inquiries instantly with zero human waiting time and 99.8% resolution accuracy.</p>

              <div class="interactive-chat-box">
                <div class="chat-history" id="demoChatHistory">
                  <div class="chat-msg msg-bot">
                    <span>👋 Hello! How can I assist you right now?</span>
                  </div>
                </div>
                <div class="chat-quick-chips">
                  <button class="chip-btn" data-chat="Track my shipment #9102">📦 Track #9102</button>
                  <button class="chip-btn" data-chat="How do I change plans?">⚡ Change plan</button>
                  <button class="chip-btn" data-chat="Talk to a human">👤 Human rep</button>
                </div>
              </div>

              <a href="#contact" class="text-link">Explore custom support bot <span>→</span></a>
            </article>

            <!-- SERVICE 2: BUSINESS PROCESS AUTOMATION SIMULATOR (CONTINUOUS STREAM) -->
            <article class="service-card scroll-gradual stagger-2">
              <div class="card-top">
                <span>02 / OPERATIONS</span>
                <span class="card-arrow">↗</span>
              </div>
              <h3>Process Automation</h3>
              <p>Automate multi-step data pipelines across webhooks, CRMs, and internal team communication tools.</p>

              <div class="interactive-pipeline-box">
                <div class="pipeline-nodes-row" id="pipelineRow">
                  <div class="p-node active" id="pn1">Trigger</div>
                  <div class="p-connector" id="pc1"></div>
                  <div class="p-node" id="pn2">AI Parse</div>
                  <div class="p-connector" id="pc2"></div>
                  <div class="p-node" id="pn3">CRM Sync</div>
                  <div class="p-connector" id="pc3"></div>
                  <div class="p-node" id="pn4">Slack Alert</div>
                </div>
                <div class="pipeline-log" id="pipelineLog">Status: Streaming live events</div>
                <button class="pipeline-run-btn" id="runPipelineBtn">
                  <span>▶</span> Force Re-trigger Event
                </button>
              </div>

              <a href="#contact" class="text-link">Explore workflow systems <span>→</span></a>
            </article>

            <!-- SERVICE 3: AI AGENTS & INTEGRATION MATRIX (PULSING HEARTBEAT) -->
            <article class="service-card scroll-gradual stagger-3">
              <div class="card-top">
                <span>03 / INTELLIGENCE</span>
                <span class="card-arrow">↗</span>
              </div>
              <h3>AI Agents & Integrations</h3>
              <p>Connect autonomous agent logic with your production databases, APIs, and business tooling.</p>

              <div class="interactive-agent-box">
                <div class="agent-hub" id="agentHub">
                  <button class="integration-pill connected" data-tool="Slack"><span class="dot"></span> Slack</button>
                  <button class="integration-pill connected" data-tool="Salesforce"><span class="dot"></span> Salesforce</button>
                  <button class="integration-pill connected" data-tool="Notion"><span class="dot"></span> Notion</button>
                  <button class="integration-pill connected" data-tool="Stripe"><span class="dot"></span> Stripe</button>
                  <button class="integration-pill connected" data-tool="Postgres"><span class="dot"></span> PostgreSQL</button>
                  <button class="integration-pill connected" data-tool="Hubspot"><span class="dot"></span> HubSpot</button>
                </div>
                <div class="agent-hub-stats">
                  <span id="hubActiveCount">6 Systems Synchronized</span>
                  <span style="color: var(--green);" id="hubEventsCount">● 2,840 events/min</span>
                </div>
              </div>

              <a href="#contact" class="text-link">Explore custom integrations <span>→</span></a>
            </article>
          </div>
        </section>

        <!-- SECTION 03: SCROLL-DRIVEN AUTOMATION JOURNEY (ANIMATED WITH SCROLLING) -->
        <section class="scroll-journey section-pad section-pad-vert scroll-gradual" id="journey">
          <div class="section-kicker">
            <span>03 / SCROLL-DRIVEN PIPELINE</span>
            <span class="kicker-rule"></span>
          </div>

          <div class="section-heading">
            <h2>
              Watch work transform<br />
              <span class="red-word">as you scroll down.</span>
            </h2>
            <p>
              Scroll down through this interactive pipeline to watch incoming raw chaos get triaged, verified, and executed in milliseconds:
            </p>
          </div>

          <div class="journey-container">
            <!-- Left: 3 Scroll-Linked Milestones -->
            <div class="journey-track-column" id="journeyTrackColumn">
              <div class="journey-vertical-line">
                <div class="journey-beam-fill" id="journeyBeamFill"></div>
              </div>

              <!-- Milestone 1 -->
              <article class="journey-stage-card is-active-stage" id="jstage1">
                <div class="journey-stage-node">01</div>
                <div class="journey-card-header">
                  <span>STAGE 01 · DATA INTAKE</span>
                  <small>LATENCY: 14MS</small>
                </div>
                <h3>Raw Chaos → Instant Ingestion</h3>
                <p>
                  Incoming requests from customer emails, PDF invoices, webhook payloads, and spreadsheets are ingested instantly with zero human waiting queues.
                </p>
                <div class="journey-chip-row">
                  <span class="journey-chip">📩 Customer Inquiries</span>
                  <span class="journey-chip">🧾 Stripe Invoices</span>
                  <span class="journey-chip">📊 Google Sheets</span>
                  <span class="journey-chip">💬 Slack Webhooks</span>
                </div>
              </article>

              <!-- Milestone 2 -->
              <article class="journey-stage-card" id="jstage2">
                <div class="journey-stage-node">02</div>
                <div class="journey-card-header">
                  <span>STAGE 02 · NEURAL LOGIC CORE</span>
                  <small>ACCURACY: 99.8%</small>
                </div>
                <h3>AI Context & Decision Engine</h3>
                <p>
                  The SIS engine validates schemas, consults enterprise knowledge bases, checks authorization boundaries, and crafts the optimal execution path.
                </p>
                <div class="journey-chip-row">
                  <span class="journey-chip">🧠 LLM Context Extraction</span>
                  <span class="journey-chip">🛡️ Guardrail Verification</span>
                  <span class="journey-chip">⚡ Business Logic Rules</span>
                  <span class="journey-chip">🔍 Database Query</span>
                </div>
              </article>

              <!-- Milestone 3 -->
              <article class="journey-stage-card" id="jstage3">
                <div class="journey-stage-node">03</div>
                <div class="journey-card-header">
                  <span>STAGE 03 · AUTONOMOUS DISPATCH</span>
                  <small>STATUS: EXECUTED</small>
                </div>
                <h3>Full Execution → Hours Reclaimed</h3>
                <p>
                  The system synchronizes CRM records, releases invoices, sends personalized customer resolutions, and pings your internal team in one coordinated pulse.
                </p>
                <div class="journey-chip-row">
                  <span class="journey-chip">✓ Salesforce Updated</span>
                  <span class="journey-chip">✓ Invoice Reconciled</span>
                  <span class="journey-chip">✓ Team Alert Dispatched</span>
                  <span class="journey-chip">✓ 18 Hours Saved</span>
                </div>
              </article>
            </div>

            <!-- Right: Sticky Telemetry Speedometer Console -->
            <div class="journey-telemetry-panel">
              <div class="telemetry-dial-wrap">
                <span class="telemetry-label">PIPELINE ADVANCEMENT</span>
                <div class="telemetry-scroll-pct" id="telemetryPct">0%</div>
                <span style="font-size: 11px; color: var(--muted);" id="telemetryStageName">Stage 01: Ingestion Active</span>
              </div>

              <div class="telemetry-row">
                <span style="color: var(--muted);">Pipeline Throughput</span>
                <strong id="telemetryThroughput">1,120 ops/sec</strong>
              </div>
              <div class="telemetry-row">
                <span style="color: var(--muted);">Active Latency</span>
                <strong style="color: var(--green);" id="telemetryLatency">18ms</strong>
              </div>
              <div class="telemetry-row">
                <span style="color: var(--muted);">Human Error Rate</span>
                <strong style="color: var(--green);">0.00% (Guarded)</strong>
              </div>
              <div class="telemetry-row">
                <span style="color: var(--muted);">Reclaimed Time</span>
                <strong style="color: var(--red);" id="telemetryHours">6 hrs / week</strong>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 04: TALKING ROBOT QUOTE (SYNCHRONIZED MOUTH & SOUND) -->
        <section class="quote-section section-pad section-pad-vert scroll-gradual" id="quote-section">
          <div class="section-kicker">
            <span>04 / AGENT PERSPECTIVE</span>
            <span class="kicker-rule"></span>
          </div>

          <div class="section-heading">
            <h2>
              In the words of<br />
              <span class="red-word">our AI architect.</span>
            </h2>
            <p>
              Listen as Spark delivers key insights on how intelligent automation elevates modern enterprise teams:
            </p>
          </div>

          <div class="quote-layout">
            <!-- Left: Talking Robot with Mouth Overlay -->
            <div class="quote-robot-stage scroll-gradual stagger-1">
              <div class="talking-robot-wrap" id="talkingRobotWrap">
                <div class="talking-robot-rig" id="talkingRobotRig">
                  <img
                    src="/robot.png"
                    alt="Spark Robot Speaking"
                    class="talking-robot-img"
                    id="talkingRobotImg"
                  />

                  <!-- Synchronized Digital Mouth Overlay (aligned with visor smile) -->
                  <div class="talking-mouth-overlay idle" id="talkingMouth">
                    <div class="mouth-digital-shape"></div>
                  </div>

                  <!-- Radiating Soundwaves -->
                  <div class="talking-soundwaves" id="talkingSoundwaves"></div>
                </div>
              </div>

              <!-- Luminous Repulsor Rings -->
              <div class="robot-repulsor" aria-hidden="true" style="bottom: 45px;">
                <div class="repulsor-ring ring-1"></div>
                <div class="repulsor-ring ring-2"></div>
              </div>

              <div class="quote-robot-badge" id="quoteStatusBadge">
                <span class="status-dot online"></span>
                <span id="quoteStatusText">DIRECTIVE SYNCHRONIZED · READY</span>
              </div>
            </div>

            <!-- Right: Word-by-Word Synchronized Quote Card -->
            <div class="quote-card scroll-gradual stagger-2">
              <div class="quote-mark">“</div>
              
              <!-- Word-by-word streaming container -->
              <div class="quote-words-container" id="quoteWordsContainer">
                <!-- Dynamically populated and highlighted word by word in sync with mouth -->
              </div>

              <div class="quote-author-row">
                <div class="quote-author-info">
                  <strong>Spark · SIS AI Systems Architect</strong>
                  <span id="quoteSubtext">SYSTEM BROADCAST · DIRECTIVE 01 OF 03</span>
                </div>

                <div class="quote-controls">
                  <button class="btn-quote-control" id="btnReplayQuote" title="Replay current quote">
                    <span>↺</span> Replay
                  </button>
                  <button class="btn-quote-control" id="btnNextQuote" title="Next wisdom directive">
                    <span>⏭</span> Next
                  </button>
                  <button class="btn-quote-control sound-active" id="btnAudioToggle" title="Toggle audio sound">
                    <span class="status-dot online" style="width:6px;height:6px;margin-right:2px;"></span>
                    <span id="audioToggleText">Sound: ON</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 04: INTERACTIVE AUTOMATION ROI CALCULATOR -->
        <section class="calculator-section section-pad section-pad-vert scroll-gradual" id="calculator">
          <div class="section-kicker">
            <span>04 / IMPACT ESTIMATOR</span>
            <span class="kicker-rule"></span>
          </div>

          <div class="section-heading">
            <h2>
              Calculate your<br />
              <span class="red-word">automation ROI.</span>
            </h2>
            <p>
              Watch the interactive calculation in action or adjust the sliders to discover your team's specific savings:
            </p>
          </div>

          <div class="calc-wrap">
            <!-- Sliders Column -->
            <div class="calc-sliders scroll-gradual stagger-1">
              <div class="calc-group">
                <div class="calc-label-row">
                  <span>Team Size (Knowledge Workers)</span>
                  <span class="calc-val" id="teamSizeVal">12 people</span>
                </div>
                <input
                  type="range"
                  min="1"
                  max="100"
                  value="12"
                  class="calc-slider"
                  id="teamSizeSlider"
                />
              </div>

              <div class="calc-group">
                <div class="calc-label-row">
                  <span>Weekly Manual Hours per Person</span>
                  <span class="calc-val" id="hoursVal">10 hrs/wk</span>
                </div>
                <input
                  type="range"
                  min="2"
                  max="35"
                  value="10"
                  class="calc-slider"
                  id="hoursSlider"
                />
              </div>

              <div class="calc-group">
                <div class="calc-label-row">
                  <span>Average Hourly Rate ($/hr)</span>
                  <span class="calc-val" id="rateVal">$45 / hr</span>
                </div>
                <input
                  type="range"
                  min="20"
                  max="150"
                  value="45"
                  step="5"
                  class="calc-slider"
                  id="rateSlider"
                />
              </div>
            </div>

            <!-- Results Column -->
            <div class="calc-results-card scroll-gradual stagger-2">
              <div class="calc-stat-grid">
                <div class="calc-stat-block">
                  <span class="calc-stat-title">HOURS SAVED / YEAR</span>
                  <span class="calc-stat-number" id="calcHoursSaved">4,320 hrs</span>
                </div>
